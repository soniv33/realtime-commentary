# Copy to `.env` and fill in. All values are optional except the two API keys.

# --- Credentials -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# --- Simulator (SIM_*) -----------------------------------------------------
SIM_HOST=127.0.0.1
SIM_PORT=8765
# Real 2023 Dutch GP distilled from OpenF1. Re-bake or pick another race with:
#   python -m f1_commentator.simulator.ingest --session-key 9149 --out data/dutch_gp_2023.jsonl
SIM_REPLAY_FILE=data/dutch_gp_2023.jsonl
SIM_SPEED_MULTIPLIER=1.0        # 1.0 = real time; >1 fast-forwards (e.g. 10 for a ~15-min demo)
SIM_MAX_GAP_SECONDS=20.0        # trims dead air; set very high (100000) for strict real time
SIM_LOOP=false

# --- LLM commentator (LLM_*) ----------------------------------------------
LLM_MODEL=claude-haiku-4-5      # fast tier; swap to claude-sonnet-5 for richer phrasing
LLM_MAX_TOKENS=90

# --- Audio / ElevenLabs (TTS_*) -------------------------------------------
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_MODEL=eleven_flash_v2_5     # Flash = lowest-latency ElevenLabs model
TTS_SAMPLE_RATE=16000
TTS_OPTIMIZE_STREAMING_LATENCY=3
TTS_ENABLE_PLAYBACK=true        # set false for headless / CI runs

# --- Orchestrator (ORCH_*) -------------------------------------------------
ORCH_BROADCAST_OFFSET_SECONDS=0.0   # delay audio to sync with a delayed TV feed
ORCH_COOLDOWN_SECONDS=4.0
ORCH_MIN_PRIORITY=40

# --- Colour commentary: the parallel context track -------------------------
# Baked context pack (standings, circuit history, form, head-to-head). Build with:
#   python -m f1_commentator.context.ingest --session-key 9582 --out data/zandvoort_2024.context.json
# Leave empty to run pure play-by-play with no analyst voice.
ORCH_CONTEXT_PACK=data/zandvoort_2024.context.json
ORCH_ENABLE_COLOUR=true
ORCH_COLOUR_AFTER_SILENCE_SECONDS=12.0   # speak once the feed has been quiet this long
ORCH_COLOUR_MIN_INTERVAL_SECONDS=25.0    # floor between colour lines
# NOTE: these are wall-clock. If you fast-forward the replay (SIM_SPEED_MULTIPLIER),
# scale them down or the analyst will never find a lull to fill.
